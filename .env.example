# ==========================================
# Email Configuration (SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Notification Center"
SMTP_USE_TLS=true

# ==========================================
# WhatsApp Provider Configuration
# Options: pywhatkit, meta, mock
# ==========================================
WA_PROVIDER=pywhatkit

# Meta Cloud API (Optional if using Meta API)
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_API_VERSION=v20.0

# ==========================================
# Throttling & Anti-Ban Settings
# ==========================================
# Delay in seconds between successive WhatsApp messages
MIN_DELAY_SECONDS=5
MAX_DELAY_SECONDS=12

# Database Path
DB_PATH=data/dispatches.db
